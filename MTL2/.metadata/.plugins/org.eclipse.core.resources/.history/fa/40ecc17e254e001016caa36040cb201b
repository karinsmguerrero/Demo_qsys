#include <stdio.h>
#include <system.h>
#include "sys/alt_stdio.h"
#include <altera_up_avalon_video_character_buffer_with_dma.h>



int main() {
	alt_up_char_buffer_dev* char_buf_dev;
	char_buf_dev = alt_up_char_buffer_open_dev("/dev/CHAR_BUFFER_avalon_char_buffer_slave");

	if( char_buf_dev== NULL)
		alt_printf("Error: could not open character buffer device \n");
	else
		alt_printf("Opened character buffer device \n");

	//800x480
	//MTL2 Bounds: x: [0..29] & y:[0..29]
	char text = 'S';
	char text_rebe_row[40] = "Now Playing...\0";
	char text_top_row[40] = "Arena x mis Venas - Rebe\0";
	char text_bottom_row[40] = "Character Buffer\0";
	alt_up_char_buffer_clear(char_buf_dev);
	alt_up_char_buffer_draw(char_buf_dev, text, 0, 0);
	alt_up_char_buffer_draw(char_buf_dev, text, 0, 29);
	alt_up_char_buffer_draw(char_buf_dev, text, 49, 0);
	alt_up_char_buffer_draw(char_buf_dev, text, 49, 29);
	alt_up_char_buffer_string(char_buf_dev, text_rebe_row, 5,15);
	alt_up_char_buffer_string(char_buf_dev, text_top_row, 5,20);
	alt_up_char_buffer_string(char_buf_dev, text_bottom_row, 40,40);
	// end program message
	printf("Program complete \n");
	return 0;


}
